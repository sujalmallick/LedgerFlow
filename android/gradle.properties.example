# ==============================================================================
# Android & Gradle configuration
# ==============================================================================
android.useAndroidX=true
android.enableJetifier=true
org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m -Djava.net.preferIPv4Stack=true

# ==============================================================================
# Release Signing Keystore Configuration (Template)
# Copy these into your local environment or gradle.properties (DO NOT commit real secrets)
# Or set them as environment variables:
#   LEDGERFLOW_UPLOAD_STORE_FILE
#   LEDGERFLOW_UPLOAD_KEY_ALIAS
#   LEDGERFLOW_UPLOAD_STORE_PASSWORD
#   LEDGERFLOW_UPLOAD_KEY_PASSWORD
# ==============================================================================
# LEDGERFLOW_UPLOAD_STORE_FILE=ledgerflow-release.keystore
# LEDGERFLOW_UPLOAD_KEY_ALIAS=ledgerflow
# LEDGERFLOW_UPLOAD_STORE_PASSWORD=your_keystore_password
# LEDGERFLOW_UPLOAD_KEY_PASSWORD=your_key_password
